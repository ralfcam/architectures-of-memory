{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Merge book chapters (full manuscript)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/merge_book_chapters.py",
        "${input:bookDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Merge book chapters (audiobook / TTS)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/merge_book_chapters.py",
        "${input:bookDir}",
        "--audiobook"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Audit book manuscript (continuity, metaphors, footnotes & OKF)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/audit_manuscript.py",
        "${input:bookDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OKF v0.2 Five-Rule Evidence Card Check",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/five_rule_check.py",
        "${input:bookDir}",
        "--online-retraction-check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Render Reader Edition PDF + HTML (Patreon / Review)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/render_publishing_pdfs.py",
        "${input:bookDir}",
        "--format",
        "a4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Compile Amazon KDP Release (6x9 Print PDF + Kindle EPUB 3)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/render_publishing_pdfs.py",
        "${input:bookDir}",
        "--format",
        "kdp-6x9",
        "--epub"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Audiobook TTS Dry-Run (estimate duration & chunks)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/generate_audiobook_tts.py",
        "${input:bookDir}",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Marketing Intelligence & Topic Scorecard (all series)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/marketing_intelligence.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "bookDir",
      "type": "pickString",
      "description": "Book or series directory",
      "options": [
        "series/architectures-of-memory/book-01-vanishing-signal",
        "series/architectures-of-memory/book-02-forget-gate",
        "series/architectures-of-memory/book-03-weight-of-attention",
        "series/architectures-of-memory/book-04-context-window",
        "series/architectures-of-memory/book-05-architecture-of-forgetting",
        "series/parenthood-atlas"
      ],
      "default": "series/architectures-of-memory/book-01-vanishing-signal"
    }
  ]
}
