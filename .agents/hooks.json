{
  "editorial-guards": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_edit_guard.py post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python hooks/post_edit_guard.py post-invocation",
        "timeout": 10
      }
    ]
  }
}
